# DemoPress 1.0 — demo.wpraffle.dev
SERVICE_FQDN_LAUNCHER=demo.wpraffle.dev
SERVICE_URL_LAUNCHER=https://demo.wpraffle.dev
SERVICE_FQDN_TEMPLATE=template.demo.wpraffle.dev
SERVICE_URL_TEMPLATE=https://template.demo.wpraffle.dev
DOMAIN=demo.wpraffle.dev
TEMPLATE_DOMAIN=template.demo.wpraffle.dev

DEMOPRESS_THEME=wpraffle
DEMOPRESS_PROFILE=wpraffle

DEFAULT_DEMO_LIFETIME=7200
MAX_DEMO_LIFETIME=43200
FAILED_RETENTION=1800
MAX_ACTIVE_DEMOS=10
MAX_ACTIVE_DEMOS_PER_IP=2
MAX_LAUNCHES_PER_IP_PER_HOUR=5
MIN_FREE_MEMORY_MB=1024

SQLITE_PATH=/data/database.sqlite
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=coolify
TRAEFIK_ENTRYPOINTS=http,https
TRAEFIK_CERTRESOLVER=letsencrypt

ADMIN_PASSWORD=CHANGE-ME-TO-A-STRONG-MANAGER-PASSWORD
INTERNAL_TEMPLATE_TOKEN=CHANGE-ME-TO-A-64-CHARACTER-RANDOM-SECRET
TEMPLATE_DB_PASSWORD=CHANGE-ME-TEMPLATE-DB-PASSWORD
TEMPLATE_DB_ROOT_PASSWORD=CHANGE-ME-TEMPLATE-DB-ROOT-PASSWORD

DEMO_IMAGE=demopress-wordpress:1.0
AUTO_BUILD_DEMO_IMAGE=1
SNAPSHOT_ROOT=/data/snapshots
MAX_SNAPSHOTS=5
TZ=Europe/London
