# DemoPress 1.0 — demo.demopress.co.uk
SERVICE_FQDN_LAUNCHER=demo.demopress.co.uk
SERVICE_URL_LAUNCHER=https://demo.demopress.co.uk
SERVICE_FQDN_TEMPLATE=template.demo.demopress.co.uk
SERVICE_URL_TEMPLATE=https://template.demo.demopress.co.uk
DOMAIN=demo.demopress.co.uk
TEMPLATE_DOMAIN=template.demo.demopress.co.uk

DEMOPRESS_THEME=default
DEMOPRESS_PROFILE=default

DEFAULT_DEMO_LIFETIME=7200
MAX_DEMO_LIFETIME=43200
FAILED_RETENTION=1800
MAX_ACTIVE_DEMOS=10
MAX_ACTIVE_DEMOS_PER_IP=2
MAX_LAUNCHES_PER_IP_PER_HOUR=5
MIN_FREE_MEMORY_MB=1024

SQLITE_PATH=/data/database.sqlite
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_NETWORK=coolify
TRAEFIK_ENTRYPOINTS=http,https
TRAEFIK_CERTRESOLVER=letsencrypt

ADMIN_PASSWORD=CHANGE-ME-TO-A-STRONG-MANAGER-PASSWORD
INTERNAL_TEMPLATE_TOKEN=CHANGE-ME-TO-A-64-CHARACTER-RANDOM-SECRET
TEMPLATE_DB_PASSWORD=CHANGE-ME-TEMPLATE-DB-PASSWORD
TEMPLATE_DB_ROOT_PASSWORD=CHANGE-ME-TEMPLATE-DB-ROOT-PASSWORD

DEMO_IMAGE=demopress-wordpress:1.0
AUTO_BUILD_DEMO_IMAGE=1
SNAPSHOT_ROOT=/data/snapshots
MAX_SNAPSHOTS=5
TZ=Europe/London

# Optional visitor / lead capture defaults.
# Each field can be off, optional or required from DemoPress Manager.
# These environment values provide the initial fallback configuration.
DEMO_CAPTURE_EMAIL=0
DEMO_REQUIRE_EMAIL=0
DEMO_CAPTURE_NAME=0
DEMO_REQUIRE_NAME=0
DEMO_CAPTURE_COMPANY=0
DEMO_REQUIRE_COMPANY=0
DEMO_CAPTURE_WEBSITE=0
DEMO_REQUIRE_WEBSITE=0
DEMO_CAPTURE_NOTICE=Your details are used to provide and manage this temporary demo.

# Optional Resend delivery of demo URL, credentials and one-click Admin link.
# Resend is independent of visitor capture. When enabled in ENV with no Manager
# override, the email field is displayed so a recipient can be supplied.
RESEND_SEND_DEMO_INFO=0
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=DemoPress
RESEND_REPLY_TO=
